    given-names: Giovanni
    affiliation: University of Bologna
license: MIT
repository-code: "https://github.com/giovanniguarnera/braneworld-bh-charge-gw"
keywords:
  - gravitational waves
  - braneworld
  - black holes
  - tidal heating
  - bilby